# Placeholders only. Copy to .env and fill in locally; never commit real values.
# Any secret also accepts a *_FILE variant pointing to a file (e.g. ENCRYPTION_KEY_FILE).
ENCRYPTION_KEY=<generate-32-bytes-base64>
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
DATABASE_PATH=<path-to-sqlite-file>
